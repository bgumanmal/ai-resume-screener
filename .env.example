# Copy this file to ".env" (same folder) and fill in your real token.
# The .env file itself should NEVER be shared, emailed, zipped up, or
# committed anywhere — it holds your live gateway credentials.

ANTHROPIC_BASE_URL=https://api-ai-us.ssnc-corp.cloud/claude
ANTHROPIC_AUTH_TOKEN=your-real-gateway-token-here

# Optional — only needed if you want to override the default model:
# ANTHROPIC_MODEL=us.anthropic.claude-sonnet-4-6
